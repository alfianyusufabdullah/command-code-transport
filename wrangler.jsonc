{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "transport",
	"compatibility_date": "2026-11-10",
	"main": "./workers/app.ts",
	"durable_objects": {
		"bindings": [{ "name": "TRANSPORT", "class_name": "TransportDurableObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransportDurableObject"] }],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
