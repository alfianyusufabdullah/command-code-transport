{
	"name": "transport",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "cross-env NODE_ENV=development react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b && tsc -p mod",
		"deploy": "npm run build && wrangler deploy",
		"preview": "npm run build && vite preview",
		"cf-typegen": "wrangler types",
		"test:relay": "node scripts/relay-check.mjs",
		"test:mod": "npm run mod:build && node scripts/mod-check.mts && node scripts/reload-check.mts",
		"test:reload": "npm run mod:build && node scripts/reload-check.mts",
		"test:switch": "npm run mod:build && node scripts/switch-check.mts",
		"mod:build": "esbuild mod/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/transport.ts --log-level=warning",
		"mod:install": "node scripts/install-mod.mjs",
		"mod:update": "npm run mod:build && npm run mod:install"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@shadcn/react": "^0.3.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"isbot": "^5.1.36",
		"lucide-react": "^1.72.0",
		"radix-ui": "^1.8.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1",
		"shiki": "^4.6.0",
		"streamdown": "^2.7.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.68.0",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.2",
		"jiti": "^2.7.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.160.0"
	}
}
